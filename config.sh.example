# mission-kickoff workspace profile — TEMPLATE
#
# Copy to <workspace-root>/.config/.mission-kickoff.sh. That file's location IS the
# declaration: the shared loader walks up from the current directory to find it, so
# adding a workspace needs no registry, no selector and no global edit. One .config/
# dir per workspace holds one dot-file per skill (.deck-skill.sh, .mw-skills.sh, …).
#
#   mkdir -p ~/Workspace/my-project/.config
#   cp config.sh.example ~/Workspace/my-project/.config/.mission-kickoff.sh
#   chmod 600 ~/Workspace/my-project/.config/.mission-kickoff.sh
#
# A workspace root is normally NOT a git worktree, so .config/ sits above every repo
# and is committed nowhere. Keep it mode 600: the shared convention allows credentials
# in these files, and if a root IS a repo, gitignore .config/ rather than letting a
# token reach a remote.
#
# Requires the shared loader at ~/.config/skill-config/loader.sh (from a bk-skills
# bundle). Without it profile.sh exits 3 and tells you how to install one.
#
# Every variable below is optional. Unset means "skip that source and say so" —
# the skill must never invent a plausible path to fill the gap.

# Self-locate: this file lives at <root>/.config/.mission-kickoff.sh, so two
# levels up is the workspace root. Keep this line; do not hardcode the root.
: "${MK_WORKSPACE_ROOT:=$(dirname "$(dirname "${BASH_SOURCE[0]}")")}"

MK_PROJECT_NAME="my-project"
# Cover the DEEPEST repo in the tree, not a round number: <root>/x/repos/<ns>/<repo>
# needs 6, and a too-small value silently omits repos from the survey.
MK_SCAN_DEPTH=5

# --- step 1: docs of record ------------------------------------------------
# Read in this order. Status claims inside them are hypotheses until verified.
MK_DOCS_OF_RECORD=(
  "$MK_WORKSPACE_ROOT/docs/roadmap.md"             # priority/status truth
  "$MK_WORKSPACE_ROOT/docs/workspace-overview.md"  # layout + conventions
)
MK_REPO_MAP_DOC="$MK_WORKSPACE_ROOT/docs/repos.md" # canonical repo/layout map

# --- step 2: optional extras -----------------------------------------------
# Live host/container inventory. Leave unset to skip; such tools usually SSH out,
# so keep their concurrency low and never let them write.
#MK_INVENTORY_CMD="cd $MK_WORKSPACE_ROOT/ops && ./bin/survey"

# Stewardship/automation log to tail after the survey. Default is
# $MK_WORKSPACE_ROOT/.qwen/tmp/hourly-repo-push.log; set empty to disable.
#MK_SWEEP_LOG="$MK_WORKSPACE_ROOT/.qwen/tmp/hourly-repo-push.log"
#MK_SWEEP_TAIL=15

# --- step 3: goals ---------------------------------------------------------
# Where this project's goals and todo lists live. Often a symlink or a directory
# beside the workspace rather than inside it.
MK_AGENT_SPACE="$MK_WORKSPACE_ROOT/agents"
MK_GOALS_FILE="$MK_AGENT_SPACE/goals/long-term-goals.md"
MK_TODOS_DIR="$MK_AGENT_SPACE/todos"

# Milestone board. Must be a complete runnable command, not a fragment.
MK_TASK_BOARD_NAME="My Board"
#MK_TASK_BOARD_CMD="bash $HOME/.agents/skills/deck/scripts/deck.sh cards 2"

# --- step 4: dispatch ------------------------------------------------------
MK_ORCA="orca-ide"                 # worker CLI; on Linux never bare `orca`
MK_AGENT="qwen-code"               # preferred worker agent (owner policy)
